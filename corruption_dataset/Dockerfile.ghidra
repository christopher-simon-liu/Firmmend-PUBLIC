FROM eclipse-temurin:21

WORKDIR /app

RUN apt-get update
RUN apt-get install -y unzip

RUN curl -L https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_11.0.3_build/ghidra_11.0.3_PUBLIC_20240410.zip > ghidra_11.0.3.zip && unzip ghidra_11.0.3.zip

ENV GHIDRA_HOME=/app/ghidra_11.0.3_PUBLIC
ENV GHIDRA_PATH=${GHIDRA_HOME}/support/analyzeHeadless

RUN mkdir /ghidra_scripts
COPY src/measurement/static/ghidra_script_acfg_disasm.py /ghidra_scripts/
ENV GHIDRA_SCRIPTS=/ghidra_scripts/
ENV GHIDRA_SCRIPT_ACFG_DISASM=ghidra_script_acfg_disasm.py

RUN mkdir /ghidra_projs
ENV GHIDRA_PROJS=/ghidra_projs/

COPY src/measurement/static/ghidra_entrypoint.sh /app/ghidra_entrypoint.sh

RUN chmod +x /app/ghidra_entrypoint.sh

ENTRYPOINT ["/app/ghidra_entrypoint.sh"]
